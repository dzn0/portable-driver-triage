{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-driver-triage:schema:triage:v1",
  "title": "Portable Driver Triage — triage.json",
  "description": "Written by the AI into reports/triage/<generated_at_compact>_<query_slug>/triage.json as the deliverable of a Mode C mass-triage pass over reports/index.jsonl. Companion triage.md is a human-readable rendering of the same content and is not schematized.",
  "type": "object",
  "required": [
    "schema_version", "query", "query_slug", "agent", "generated_at",
    "rows_scanned", "rows_after_dedup", "predicate_used",
    "candidates", "no_matches_but_closely_related", "unknowns"
  ],
  "additionalProperties": false,
  "properties": {

    "schema_version": { "const": 1 },

    "query": {
      "type": "string",
      "minLength": 1,
      "description": "Researcher's question, verbatim."
    },

    "query_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 60,
      "description": "Kebab-case tag used as part of the deliverable directory name."
    },

    "agent": {
      "type": "string",
      "minLength": 1,
      "description": "Model identifier that produced this document."
    },

    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },

    "rows_scanned": {
      "type": "integer",
      "minimum": 0,
      "description": "Total rows read from reports/index.jsonl before dedup."
    },

    "rows_after_dedup": {
      "type": "integer",
      "minimum": 0,
      "description": "Row count after dedup by (sha256, scope_profile) keeping the most recent generated_at."
    },

    "predicate_used": {
      "type": "string",
      "minLength": 1,
      "description": "One-sentence human-readable predicate derived from the query. Shown to the operator so the filter logic is auditable."
    },

    "candidates": {
      "type": "array",
      "description": "Ranked list of drivers that matched the predicate. Empty array is valid.",
      "items": { "$ref": "#/$defs/candidate" }
    },

    "no_matches_but_closely_related": {
      "type": "array",
      "description": "Near-miss candidates — e.g. researcher asked about MSR writes, nothing matched exactly but some CR-register-write candidates exist. Never promote to `candidates`.",
      "items": { "$ref": "#/$defs/candidate" }
    },

    "unknowns": {
      "type": "array",
      "description": "Things the index did not let the AI resolve. One short line each.",
      "items": { "type": "string", "minLength": 1 }
    }
  },

  "$defs": {

    "candidate": {
      "type": "object",
      "required": ["sha256", "scope_profile", "run_id", "rank", "one_liner", "matched_signals", "status", "bundle_path"],
      "additionalProperties": false,
      "properties": {
        "sha256":        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scope_profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "run_id":        { "type": "string", "pattern": "^\\d{8}T\\d{6}Z-[a-z0-9-]+$" },
        "rank":          { "type": "integer", "minimum": 0 },
        "one_liner":     { "type": "string", "minLength": 1, "maxLength": 300, "description": "Short, factual, cites which signals matched." },

        "matched_signals": {
          "type": "object",
          "required": ["scope_matches", "dangerous_imports_hit", "device_classes_hit", "interesting_strings_hit", "clone_hits"],
          "additionalProperties": false,
          "properties": {
            "scope_matches": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["scope", "rank"],
                "additionalProperties": false,
                "properties": {
                  "scope": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                  "rank":  { "type": "integer", "minimum": 0 }
                }
              }
            },
            "dangerous_imports_hit":   { "type": "array", "items": { "type": "string" } },
            "device_classes_hit": {
              "type": "array",
              "items": { "enum": ["hid", "input", "disk", "net", "process", "memory", "msr", "gpu", "usb", "filter", "generic"] }
            },
            "interesting_strings_hit": { "type": "array", "items": { "type": "string" } },
            "clone_hits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ref_id", "cve", "similarity"],
                "additionalProperties": false,
                "properties": {
                  "ref_id":     { "type": "string" },
                  "cve":        { "type": ["string", "null"], "pattern": "^CVE-\\d{4}-\\d{4,}$" },
                  "similarity": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },

        "status": {
          "enum": ["already_analyzed_deep", "needs_deep_rerun"],
          "description": "`already_analyzed_deep` — the matched row has top_findings_preview populated; Mode A on bundle_path can read the prior deep findings. `needs_deep_rerun` — the matched row was analyzed under a different scope than the capability asked about."
        },

        "bundle_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path from the row's evidence_pointers, relative to project root."
        }
      }
    }
  }
}
